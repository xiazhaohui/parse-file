{
  "name": "@xiazhaohui/parse-file",
  "description": "",
  "version": "0.0.10",
  "main": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    }
  },
  "types": "dist/index.d.ts",
  "publisher": "lesslessmorexzh@gmail.com",
  "scripts": {
    "build:tsc": "tsc",
    "build:webpack": "webpack --mode production",
    "build:esm": "webpack --config webpack.config.js --env format=esm",
    "build:umd": "webpack --config webpack.config.js --env format=umd",
    "build": "rm -rf dist && npm run build:esm && npm run build:umd"
  },
  "keywords": [
    "@xiazhaohui/parse-file",
    "parse-file",
    "解析文件",
    "文件解析",
    "校验文件",
    "文件校验",
    "魔术数字",
    "文件签名",
    "文件扩展名"
  ],
  "author": "lesslessmore",
  "license": "MIT",
  "homepage": "https://github.com/xiazhaohui/parse-file",
  "devDependencies": {
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "path": "^0.12.7"
  }
}
